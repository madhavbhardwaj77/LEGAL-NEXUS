# ===================================================
# LEGAL-NEXUS (Nyaya Setu) Environment Configuration
# ===================================================

# Environment Mode: development | production | test
NODE_ENV=development

# Backend HTTP Server Port
PORT=5000

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Defaults to persistent local MongoDB)
MONGODB_URI=mongodb://localhost:27017/nyaya-setu

# Redis Connection (Optional, system operates in resilient fallback mode if offline)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT Secrets (Generate secure random 32+ character keys for production)
JWT_SECRET=change_this_to_a_secure_jwt_secret_key_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_to_a_secure_refresh_secret_key_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Python AI Engine Gateway Microservice URL
AI_ENGINE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Logging Level: debug | info | warn | error
LOG_LEVEL=info
